# Recast Recorder Configuration
# Copy this file to config.toml and modify as needed

[recorder]
id = "recorder-wilma-01"
hostname = "wilma"
management_server_url = "http://kate:5000"
poll_interval = 10
heartbeat_interval = 30

[recording]
screen_width = 1920
screen_height = 1080
framerate = 30
audio_source_name = "virtsink.monitor"
# Optional: Capture at higher framerate for smoother motion
# input_framerate = 60  # Capture rate from X11 (0 = use framerate)
# output_framerate = 30  # Encode rate (0 = use framerate). Requires input_framerate > output_framerate

[video]
preset = "ultrafast"
crf = 28
maxrate_kbps = 2000
bufsize_kbps = 4000
threads = 2
pix_fmt = "yuv420p"
profile = "baseline"
gop_multiplier = 2
hls_list_size = 0
hls_flags = "independent_segments+append_list"
hls_playlist_type = "event"
# If > 0, overrides gop_multiplier and sets GOP to (framerate * gop_seconds)
gop_seconds = 0
# Video sync mode (replaces deprecated -vsync usage). Common values: cfr, vfr, passthrough
fps_mode = "cfr"
hls_time = 5
hw_accel = "none"

# NVENC-specific options (used when hw_accel = "nvenc")
nvenc_preset = "p4"
nvenc_rc = "vbr"
nvenc_tune = ""
nvenc_cq = 0
nvenc_profile = ""
nvenc_bframes = 0
nvenc_lookahead = 0
nvenc_spatial_aq = 0
nvenc_temporal_aq = 0
nvenc_aq_strength = 0

[audio]
bitrate_kbps = 192
sample_rate = 48000
channels = 2

[paths]
output_dir = "/opt/recast/recordings"
chrome_profiles_dir = "/opt/recast/.recast-chrome"
