[Unit]
Description=Recast Server
After=network-online.target
Wants=network-online.target
# Never stop retrying restarts, regardless of crash frequency
StartLimitIntervalSec=0

[Service]
Type=simple
User=recast
WorkingDirectory=/opt/recast
ExecStart=/opt/recast/venv/bin/python3 /opt/recast/recast_server.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
