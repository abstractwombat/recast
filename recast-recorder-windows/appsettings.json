{
  "Recorder": {
    "ManagementServerUrl": "http://192.168.0.70:5000",
    "RecorderId": "windows-worker",
    "RecorderHostname": "TheMike",
    "PollInterval": 10,
    "HeartbeatInterval": 30,
    "VncPort": 5900,
    "FfmpegPath": "ffmpeg.exe",

    "AudioApi": "dshow",
    "AudioDevice": "CABLE Output (VB-Audio Virtual Cable)",
    "AudioBitrateK": 192,
    "AudioSampleRate": 44100,
    "AudioChannels": 2,

    "Width": 1920,
    "Height": 1080,
    "Framerate": 60,
    "VideoThreadQueueSize": 4096,
    "AudioThreadQueueSize": 4096,

    "CaptureMethod": "gdigrab",
    "DdagrabOutputIdx": 0,
    "DdagrabDrawMouse": true,

    "VideoPreset": "medium",
    "VideoCrf": 18,
    "VideoProfile": "high",
    "VideoPixFmt": "yuv420p",
    "VideoThreads": 2,
    "VideoBitrateK": 9000,
    "VideoMaxrateK": 9000,
    "VideoBufsizeK": 18000,

    "GopMult": 2,
    "GopSeconds": 0,
    "HlsTime": 2,
    "HlsListSize": 0,
    "HlsFlags": "append_list+omit_endlist",
    "HlsPlaylistType": "event",

    "FpsMode": "cfr",
    "ForceCfr": true,

    "HwAccel": "nvenc",
    "VideoEncoder": "h264_nvenc",

    "NvencPreset": "p5",
    "NvencRc": "cbr",
    "NvencTune": "",
    "NvencCq": 0,
    "NvencProfile": "high",
    "NvencBframes": 0,
    "NvencLookahead": 0,
    "NvencSpatialAq": 0,
    "NvencTemporalAq": 0,
    "NvencAqStrength": 0,
    "NvencQp": 0,

    "OutputDirectory": "recordings",

    "FinalizeHardCapMinutes": 120,
    "FinalizeStallCapMinutes": 5,
    "FinalizeLogIntervalSeconds": 20,
    "RecorderLogLevel": "information",

    "DdaProbeEnabled": true,
    "DdaProbeIntervalSeconds": 300,
    "DdaProbeTimeoutSeconds": 8,
    "DdaProbeRestartOnFail": false,

    "ChoppyStreamDetectionEnabled": true,
    "ChoppyStreamThresholdPerSecond": 30,
    "ChoppyStreamCorrectionAction": "restart_ffmpeg",
    "ChoppyStreamGracePeriodSeconds": 5
  }
