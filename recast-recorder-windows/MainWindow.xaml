<Window x:Class="Recast.WindowsRecorder.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recast Windows Recorder" Height="260" Width="540" WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,8" VerticalAlignment="Center">
            <TextBlock Text="Management Server:" FontWeight="Bold"/>
            <TextBlock Text=" " />
            <TextBlock Text="{Binding ManagementUrl}"/>
            <Ellipse Width="12" Height="12" Margin="12,0,0,0">
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Setter Property="Fill" Value="Gray"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ManagementConnected}" Value="True">
                                <Setter Property="Fill" Value="LimeGreen"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ManagementConnected}" Value="False">
                                <Setter Property="Fill" Value="Tomato"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Recorder:" FontWeight="Bold"/>
            <TextBlock Text=" " />
            <TextBlock Text="{Binding RecorderId}"/>
            <TextBlock Text=", Hostname:" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding Hostname}"/>
            <TextBlock Text=", Status:" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding Status}"/>
            <TextBlock Text=", Job:" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding CurrentJobId}"/>
            <TextBlock Text=", Last heartbeat:" Margin="12,0,0,0"/>
            <TextBlock Text="{Binding LastHeartbeat}"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" VerticalAlignment="Top">
            <Button Content="Open Control" Click="OpenControl_Click" Margin="0,0,8,0"/>
            <Button Content="Open HLS Root" Click="OpenHls_Click" Margin="0,0,8,0"/>
            <Button Content="Quit" Click="Quit_Click"/>
        </StackPanel>
    </Grid>
</Window>
